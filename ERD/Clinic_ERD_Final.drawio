  <diagram id="patients-clinical" name="03 - Patients &amp; Clinical Records">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1550" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="pc-title" value="&lt;b&gt;Patients, Prescriptions &amp; Follow-ups&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748b'&gt;Permanent patient file and immutable prescription revision history&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="2100" height="62"/>
        </mxCell>
        <mxCell id="patient" value="&lt;b&gt;Patient&lt;/b&gt;&lt;hr/&gt;PK Id&lt;br/&gt;AK FileNumber (never reused)&lt;br/&gt;AK PrimaryPhoneNumber&lt;br/&gt;SecondaryPhoneNumber? [contact only]&lt;br/&gt;FullName&lt;br/&gt;BirthDate?&lt;br/&gt;AgeAtRegistration?&lt;br/&gt;AgeRecordedAt?&lt;br/&gt;Gender (Male / Female)&lt;br/&gt;Area? / Address? / Email?&lt;br/&gt;GuardianName? / GuardianPhoneNumber?&lt;br/&gt;IsArchived&lt;br/&gt;CreatedBy / CreatedAt&lt;br/&gt;UpdatedBy? / UpdatedAt?&lt;br/&gt;RowVersion&lt;br/&gt;CK DOB or age+recorded date&lt;br/&gt;CK secondary differs from primary" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="120" width="380" height="430"/>
        </mxCell>
        <mxCell id="patient-note" value="&lt;b&gt;PatientNote&lt;/b&gt;&lt;hr/&gt;PK Id&lt;br/&gt;FK PatientId&lt;br/&gt;NoteText&lt;br/&gt;Visibility (Staff / AdminOnly)&lt;br/&gt;CreatedByUserId&lt;br/&gt;CreatedAt&lt;br/&gt;IsArchived&lt;br/&gt;RowVersion" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="480" y="120" width="320" height="245"/>
        </mxCell>
        <mxCell id="treatment-history" value="&lt;b&gt;TreatmentHistory&lt;/b&gt;&lt;hr/&gt;PK Id&lt;br/&gt;FK PatientId&lt;br/&gt;EventDate&lt;br/&gt;Description&lt;br/&gt;CreatedByUserId&lt;br/&gt;CreatedAt&lt;br/&gt;IsArchived&lt;br/&gt;RowVersion" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="860" y="120" width="320" height="245"/>
        </mxCell>
        <mxCell id="appointment-service-ref" value="&lt;b&gt;AppointmentService&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748b'&gt;&lt;i&gt;external reference&lt;/i&gt;&lt;/font&gt;&lt;hr/&gt;PK Id&lt;br/&gt;FK AppointmentId&lt;br/&gt;Doctor + service assignment&lt;br/&gt;See page 02" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#f5f5f5;strokeColor=#9ca3af;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1580" y="120" width="320" height="145"/>
        </mxCell>
        <mxCell id="appointment-ref" value="&lt;b&gt;Appointment&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748b'&gt;&lt;i&gt;external reference&lt;/i&gt;&lt;/font&gt;&lt;hr/&gt;PK Id&lt;br/&gt;FK PatientId&lt;br/&gt;See page 02" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#f5f5f5;strokeColor=#9ca3af;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1960" y="120" width="280" height="115"/>
        </mxCell>
        <mxCell id="user-ref" value="&lt;b&gt;ApplicationUser&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748b'&gt;&lt;i&gt;external reference&lt;/i&gt;&lt;/font&gt;&lt;hr/&gt;PK Id&lt;br/&gt;Admin / Secretary&lt;br/&gt;See page 06" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#f5f5f5;strokeColor=#9ca3af;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2300" y="120" width="260" height="115"/>
        </mxCell>
        <mxCell id="prescription" value="&lt;b&gt;Prescription&lt;/b&gt;&lt;hr/&gt;PK Id&lt;br/&gt;FK AppointmentServiceId&lt;br/&gt;AK AppointmentServiceId&lt;br/&gt;FK (CurrentRevisionId, Id)?&lt;br/&gt;Status (Draft / Finalized / Voided)&lt;br/&gt;CreatedByUserId&lt;br/&gt;CreatedAt&lt;br/&gt;FinalizedByUserId? / FinalizedAt?&lt;br/&gt;VoidedByAdminUserId? / VoidedAt?&lt;br/&gt;VoidReason?&lt;br/&gt;RowVersion" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="610" width="360" height="320"/>
        </mxCell>
        <mxCell id="prescription-revision" value="&lt;b&gt;PrescriptionRevision&lt;/b&gt;&lt;hr/&gt;PK Id&lt;br/&gt;FK PrescriptionId&lt;br/&gt;AK (Id, PrescriptionId)&lt;br/&gt;AK (PrescriptionId, RevisionNumber)&lt;br/&gt;RevisionNumber&lt;br/&gt;CreatedByUserId&lt;br/&gt;CreatedAt&lt;br/&gt;ChangeReason?&lt;br/&gt;ReturnDate?&lt;br/&gt;CK RevisionNumber &amp;gt; 0" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="470" y="610" width="360" height="280"/>
        </mxCell>
        <mxCell id="prescription-item" value="&lt;b&gt;PrescriptionItem&lt;/b&gt;&lt;hr/&gt;PK Id&lt;br/&gt;FK PrescriptionRevisionId&lt;br/&gt;AK (PrescriptionRevisionId, SortOrder)&lt;br/&gt;SortOrder&lt;br/&gt;MedicineName&lt;br/&gt;DoseAmount? / DoseUnit?&lt;br/&gt;TimesPerDay?&lt;br/&gt;FrequencyText?&lt;br/&gt;DurationText?&lt;br/&gt;FoodTiming? (Before / After meal)&lt;br/&gt;Instructions?" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="900" y="610" width="370" height="305"/>
        </mxCell>
        <mxCell id="follow-up" value="&lt;b&gt;FollowUp&lt;/b&gt;&lt;hr/&gt;PK Id&lt;br/&gt;FK PrescriptionId / AK PrescriptionId&lt;br/&gt;FK PatientId / DepartmentId&lt;br/&gt;ReturnDate&lt;br/&gt;Status (Due / Completed / Cancelled)&lt;br/&gt;FK (ResultAppointmentId, PatientId)?&lt;br/&gt;AK ResultAppointmentId? (filtered)&lt;br/&gt;CreatedByUserId / CreatedAt&lt;br/&gt;ClosedByUserId? / ClosedAt?&lt;br/&gt;ClosureReason?&lt;br/&gt;RowVersion" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1340" y="610" width="350" height="320"/>
        </mxCell>
        <mxCell id="pc-rules" value="&lt;b&gt;Clinical record rules&lt;/b&gt;&lt;hr/&gt;• The secretary transcribes the doctor's written prescription after the appointment service is completed; doctors and patients have no system login.&lt;br/&gt;• Prescription.CurrentRevisionId is a real FK to a revision of the same prescription; it is assigned after the first revision is inserted.&lt;br/&gt;• Every save creates a new immutable revision. Existing revisions and medicine lines are never overwritten or deleted.&lt;br/&gt;• The secretary finalizes a draft after explicit doctor-prescription matching; only the admin may correct or void a finalized prescription, with a mandatory reason.&lt;br/&gt;• ReturnDate automatically creates one Due FollowUp, not an appointment. The secretary explicitly chooses an eligible time and doctor.&lt;br/&gt;• Converting a FollowUp atomically creates a non-suspended appointment for the same patient and department, then marks it Completed.&lt;br/&gt;• Voiding a prescription cancels a Due follow-up; completed/cancelled follow-ups and their appointments remain unchanged.&lt;br/&gt;• AdminOnly patient notes must never be returned by secretary-facing queries or offline snapshots." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#1f2937;dashed=1;fillColor=#fffdf2;strokeColor=#d6b656;strokeWidth=1.3;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1770" y="560" width="790" height="430"/>
        </mxCell>
        <mxCell id="pc-e02" value="1 — N | has" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.25;labelBackgroundColor=#ffffff;startArrow=none;startFill=0;endArrow=classic;endFill=0;" edge="1" parent="1" source="patient" target="patient-note">
