        </mxCell>
        <mxCell id="appointment-ref" value="&lt;b&gt;Appointment&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748b'&gt;&lt;i&gt;external reference&lt;/i&gt;&lt;/font&gt;&lt;hr/&gt;PK Id&lt;br/&gt;See page 02" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#f5f5f5;strokeColor=#9ca3af;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="650" width="280" height="105"/>
        </mxCell>
        <mxCell id="payment-ref" value="&lt;b&gt;Payment&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748b'&gt;&lt;i&gt;external reference&lt;/i&gt;&lt;/font&gt;&lt;hr/&gt;PK Id&lt;br/&gt;AK (Id, PatientId)&lt;br/&gt;See page 04" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#f5f5f5;strokeColor=#9ca3af;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="650" width="280" height="120"/>
        </mxCell>
        <mxCell id="shift-ref" value="&lt;b&gt;Shift&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748b'&gt;&lt;i&gt;external reference&lt;/i&gt;&lt;/font&gt;&lt;hr/&gt;PK Id&lt;br/&gt;See page 04" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#f5f5f5;strokeColor=#9ca3af;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="720" y="650" width="280" height="105"/>
        </mxCell>
        <mxCell id="approval-request" value="&lt;b&gt;ApprovalRequest&lt;/b&gt;&lt;hr/&gt;PK Id&lt;br/&gt;RequestType = AppointmentCancellation&lt;br/&gt;FK AppointmentId&lt;br/&gt;FK OriginalPaymentId?&lt;br/&gt;RequestedAmount? [server-calculated]&lt;br/&gt;RequestedByUserId&lt;br/&gt;RequestedAt&lt;br/&gt;RequestNote&lt;br/&gt;Status (Pending/Approved/Rejected/Cancelled)&lt;br/&gt;ReviewedByAdminUserId?&lt;br/&gt;ReviewedAt?&lt;br/&gt;DecisionReason?&lt;br/&gt;RowVersion&lt;br/&gt;CK payment and amount coexist" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#e6e6e6;strokeColor=#666666;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1060" y="570" width="410" height="410"/>
        </mxCell>
        <mxCell id="refund-ref" value="&lt;b&gt;Refund&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748b'&gt;&lt;i&gt;external reference&lt;/i&gt;&lt;/font&gt;&lt;hr/&gt;PK Id&lt;br/&gt;FK ApprovalRequestId&lt;br/&gt;See page 04" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#f5f5f5;strokeColor=#9ca3af;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1530" y="650" width="280" height="120"/>
        </mxCell>
        <mxCell id="audit-log" value="&lt;b&gt;AuditLog&lt;/b&gt;&lt;hr/&gt;PK Id&lt;br/&gt;FK ActorUserId?&lt;br/&gt;ActorType (User / System)&lt;br/&gt;Action&lt;br/&gt;EntityType / EntityId&lt;br/&gt;OccurredAt&lt;br/&gt;Reason?&lt;br/&gt;OldValuesJson?&lt;br/&gt;NewValuesJson?&lt;br/&gt;CorrelationId?&lt;br/&gt;IpAddress?&lt;br/&gt;CK actor consistency&lt;br/&gt;Append-only" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#e6e6e6;strokeColor=#666666;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1870" y="570" width="390" height="330"/>
        </mxCell>
        <mxCell id="ia-rules" value="&lt;b&gt;Security and approval rules&lt;/b&gt;&lt;hr/&gt;• The admin creates secretary accounts; self-service signup and email approval are out of scope.&lt;br/&gt;• Password hashes and refresh-token hashes only—never store plaintext secrets.&lt;br/&gt;• After five failed attempts, lock the account temporarily; the admin may unlock it earlier.&lt;br/&gt;• ApplicationUserRole has one row per user. Provisioning must enforce exactly one active Admin account.&lt;br/&gt;• AppointmentCancellation targets one Appointment; the server derives its original payment and full remaining refundable amount.&lt;br/&gt;• Only the single active Admin may approve/reject; approval immediately cancels the booking and releases its resources.&lt;br/&gt;• A secretary with a valid active shift executes an approved refund; the admin cannot change the approved amount.&lt;br/&gt;• Rejected/approved decisions require a reason where the workflow changes financial or confirmed-booking history.&lt;br/&gt;• AuditLog is append-only. Automated shift/status events use ActorType=System with ActorUserId NULL.&lt;br/&gt;• AdminOnly notes and security fields are excluded from secretary permissions and offline read-only snapshots.&lt;br/&gt;• Two-factor authentication is extension-ready but not required in the low-cost initial scope." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#1f2937;dashed=1;fillColor=#fffdf2;strokeColor=#d6b656;strokeWidth=1.3;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2310" y="500" width="400" height="540"/>
        </mxCell>
        <mxCell id="ia-e01" value="1 — 1 | has exactly one role" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.25;labelBackgroundColor=#ffffff;startArrow=none;startFill=0;endArrow=classic;endFill=0;" edge="1" parent="1" source="application-user" target="application-user-role">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="ia-e02" value="1 — N | assigned to" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.25;labelBackgroundColor=#ffffff;startArrow=none;startFill=0;endArrow=classic;endFill=0;" edge="1" parent="1" source="application-role" target="application-user-role">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="ia-e03" value="1 — N | has" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.25;labelBackgroundColor=#ffffff;startArrow=none;startFill=0;endArrow=classic;endFill=0;" edge="1" parent="1" source="application-user" target="user-session">
