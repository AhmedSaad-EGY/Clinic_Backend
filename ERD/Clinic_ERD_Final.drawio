        <mxCell id="ia-title" value="&lt;b&gt;Identity, Security, Approvals &amp; Audit&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748b'&gt;Admin-provisioned accounts, typed approval targets and an immutable audit trail&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#1f2937;" vertex="1" parent="1">
