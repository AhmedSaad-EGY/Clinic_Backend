        <mxCell id="refund-package-allocation" value="&lt;b&gt;RefundPackageAllocation&lt;/b&gt;&lt;hr/&gt;PK Id&lt;br/&gt;FK (RefundId, OriginalPaymentId)&lt;br/&gt;FK (OriginalPackageAllocationId, OriginalPaymentId)&lt;br/&gt;OriginalPaymentId [enforcement key]&lt;br/&gt;Amount&lt;br/&gt;CK Amount &amp;gt; 0" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1470" y="1010" width="440" height="270"/>
        </mxCell>
        <mxCell id="fn-rules" value="&lt;b&gt;Financial invariants&lt;/b&gt;&lt;hr/&gt;• A payment may cover several bookings/packages and use several payment methods, but all targets must belong to Payment.PatientId.&lt;br/&gt;• Patient packages support full payment only; an allocation targets the PatientPackage, never an individual session.&lt;br/&gt;• Sum(method allocations) = Payment.TotalAmount = sum(booking + package allocations).&lt;br/&gt;• A paid booking is cancelled only after admin approval; approval cancels the booking immediately and the secretary executes the full remaining refund later from an active shift.&lt;br/&gt;• Every refund allocation belongs to Refund.OriginalPaymentId and may use only original payment methods without exceeding each method's remaining balance.&lt;br/&gt;• Sum(refund method allocations) = Refund.Amount = the booking's full remaining refundable amount; partial booking refunds are not supported.&lt;br/&gt;• Cash revenue appears in the shift/day in which collection occurs, even if the booking was created earlier.&lt;br/&gt;• Expected cash = opening balance + cash collections + cash corrections − cash refunds − cash expenses/withdrawals and may be negative with a warning.&lt;br/&gt;• The secretary enters DeclaredCash first; only then does the system reveal CashVariance. Every variance is retained.&lt;br/&gt;• Opening balance is always recorded explicitly, including a zero balance, before any collection.&lt;br/&gt;• Effective Open/Grace state is evaluated from Africa/Cairo time on request; no background scheduler is required.&lt;br/&gt;• The closing grace period counts toward same-secretary overlap; different secretaries may overlap because each has an independent drawer.&lt;br/&gt;• Payment.CollectedByUserId must match the secretary who owns the shift's CashDrawer.&lt;br/&gt;• Future shifts are cancelled rather than deleted; closed and cancelled shifts are immutable.&lt;br/&gt;• A closed shift is immutable to secretaries. Only an admin can post a dated corrective/reversal movement with a mandatory reason.&lt;br/&gt;• Electronic methods are reconciled separately and then combined in the shift summary." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#1f2937;dashed=1;fillColor=#fffdf2;strokeColor=#d6b656;strokeWidth=1.3;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1990" y="930" width="1260" height="610"/>
        </mxCell>
        <mxCell id="fn-e01" value="1 — 0..1 | owns as secretary" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.25;labelBackgroundColor=#ffffff;startArrow=none;startFill=0;endArrow=classic;endFill=0;" edge="1" parent="1" source="user-ref" target="cash-drawer">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="fn-e02" value="1 — N | has" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.25;labelBackgroundColor=#ffffff;startArrow=none;startFill=0;endArrow=classic;endFill=0;" edge="1" parent="1" source="cash-drawer" target="shift">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="fn-e03" value="1 — N | records" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.25;labelBackgroundColor=#ffffff;startArrow=none;startFill=0;endArrow=classic;endFill=0;" edge="1" parent="1" source="shift" target="shift-movement">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="fn-e04" value="0..1 — N | classifies method" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.25;labelBackgroundColor=#ffffff;startArrow=none;startFill=0;endArrow=classic;endFill=0;" edge="1" parent="1" source="payment-method" target="shift-movement">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="fn-e05" value="1 — N | collects" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.25;labelBackgroundColor=#ffffff;startArrow=none;startFill=0;endArrow=classic;endFill=0;" edge="1" parent="1" source="shift" target="payment">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="fn-e06" value="1 — N | pays" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.25;labelBackgroundColor=#ffffff;startArrow=none;startFill=0;endArrow=classic;endFill=0;" edge="1" parent="1" source="patient-ref" target="payment">
          <mxGeometry as="geometry" relative="1"/>
