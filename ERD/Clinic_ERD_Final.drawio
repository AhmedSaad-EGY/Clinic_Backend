          <mxGeometry as="geometry" x="1730" y="410" width="430" height="350"/>
        </mxCell>
        <mxCell id="discount" value="&lt;b&gt;Discount&lt;/b&gt;&lt;hr/&gt;PK Id&lt;br/&gt;Name&lt;br/&gt;Type (Percent / FixedAmount)&lt;br/&gt;Value&lt;br/&gt;AppliesTo (Bookings/Packages/Both)&lt;br/&gt;ScopeMode (All / Selected)&lt;br/&gt;Priority&lt;br/&gt;StartAt / EndAt?&lt;br/&gt;IsActive&lt;br/&gt;CreatedByAdminUserId&lt;br/&gt;CreatedAt / UpdatedAt&lt;br/&gt;RowVersion&lt;br/&gt;CK percent 0..100; fixed &amp;gt; 0" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
