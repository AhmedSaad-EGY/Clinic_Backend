          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="ia-e05" value="1 — N | requests / reviews" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.25;labelBackgroundColor=#ffffff;startArrow=none;startFill=0;endArrow=classic;endFill=0;" edge="1" parent="1" source="application-user" target="approval-request">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="ia-e06" value="0..1 — N | target for cancellation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.25;labelBackgroundColor=#ffffff;startArrow=none;startFill=0;endArrow=classic;endFill=0;" edge="1" parent="1" source="appointment-ref" target="approval-request">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="ia-e07" value="0..1 — N | target for refund" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.25;labelBackgroundColor=#ffffff;startArrow=none;startFill=0;endArrow=classic;endFill=0;" edge="1" parent="1" source="payment-ref" target="approval-request">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="ia-e08" value="0..1 — N | target for cash movement" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.25;labelBackgroundColor=#ffffff;startArrow=none;startFill=0;endArrow=classic;endFill=0;" edge="1" parent="1" source="shift-ref" target="approval-request">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="ia-e09" value="1 — 0..1 | authorizes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.25;labelBackgroundColor=#ffffff;startArrow=none;startFill=0;endArrow=classic;endFill=0;" edge="1" parent="1" source="approval-request" target="refund-ref">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="ia-e10" value="0..1 — N | acts as" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.25;labelBackgroundColor=#ffffff;startArrow=none;startFill=0;endArrow=classic;endFill=0;" edge="1" parent="1" source="application-user" target="audit-log">
