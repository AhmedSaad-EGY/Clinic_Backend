        <mxCell id="discount-package" value="&lt;b&gt;DiscountPackage&lt;/b&gt;&lt;hr/&gt;PK (DiscountId, PackageId)&lt;br/&gt;FK DiscountId&lt;br/&gt;FK PackageId" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="840" y="970" width="340" height="150"/>
        </mxCell>
        <mxCell id="pd-rules" value="&lt;b&gt;Package and discount invariants&lt;/b&gt;&lt;hr/&gt;• A purchasable Package requires positive activation-grace and usage-duration days; old incomplete definitions remain historical only.&lt;br/&gt;• Registration snapshots package, department, specialization, service, quantity, unit price, total price and both time policies.&lt;br/&gt;• PatientPackage.TotalSessions equals the sum of PatientPackageService.SessionsPurchased, with one uniquely ordered PackageSession per purchased session.&lt;br/&gt;• Non-free packages remain unpaid and unusable until a later full-payment flow; free packages need no zero-value Payment and start their activation window at registration.&lt;br/&gt;• Usage duration begins only on the first completed package session. No-show neither starts duration nor consumes a session.&lt;br/&gt;• A booking will reserve one PackageSession; final consumption occurs only when its visit is completed. Reservation and consumption are implemented in later phases.&lt;br/&gt;• Department closure blocks use dynamically without changing deadlines. Admin may only extend an existing deadline forward, with rowversion, reason and audit.&lt;br/&gt;• Registration uses actor-bound idempotency; composite keys keep patient/package/service ownership aligned; mutable records use rowversion.&lt;br/&gt;• Discount scopes may target a full department, selected services, selected packages, or all eligible items.&lt;br/&gt;• Only one discount applies to a line. The chosen discount and calculated values are snapshotted on AppointmentService/PatientPackage.&lt;br/&gt;• An admin may force-apply or exclude a discount for one booking with a mandatory reason; the secretary cannot edit price.&lt;br/&gt;• Fixed discounts cannot exceed the base amount; only bookings/purchases created after StartAt are eligible." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#1f2937;dashed=1;fillColor=#fffdf2;strokeColor=#d6b656;strokeWidth=1.3;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1260" y="910" width="1420" height="500"/>
        </mxCell>
        <mxCell id="pd-e18" value="1 — N | owns definitions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.25;labelBackgroundColor=#ffffff;startArrow=none;startFill=0;endArrow=classic;endFill=0;" edge="1" parent="1" source="department-ref" target="package">
          <mxGeometry as="geometry" relative="1"/>
        </mxCell>
        <mxCell id="pd-e19" value="1 — N | creates / updates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.25;labelBackgroundColor=#ffffff;startArrow=none;startFill=0;endArrow=classic;endFill=0;" edge="1" parent="1" source="user-ref" target="package">
