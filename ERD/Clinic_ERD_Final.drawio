        <mxCell id="refund" value="&lt;b&gt;Refund&lt;/b&gt;&lt;hr/&gt;PK Id&lt;br/&gt;AK TransactionNumber&lt;br/&gt;AK IdempotencyKey&lt;br/&gt;RequestFingerprint (char 64)&lt;br/&gt;FK ApprovalRequestId&lt;br/&gt;FK OriginalPaymentId&lt;br/&gt;FK ExecutionShiftId&lt;br/&gt;AK ApprovalRequestId&lt;br/&gt;AK (Id, OriginalPaymentId)&lt;br/&gt;Amount&lt;br/&gt;ExecutedByUserId&lt;br/&gt;ExecutedAt&lt;br/&gt;Status (Posted / Reversed)&lt;br/&gt;Note?&lt;br/&gt;RowVersion&lt;br/&gt;CK Amount &amp;gt; 0" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1010" width="390" height="350"/>
        </mxCell>
        <mxCell id="refund-method-allocation" value="&lt;b&gt;RefundMethodAllocation&lt;/b&gt;&lt;hr/&gt;PK Id&lt;br/&gt;FK (RefundId, OriginalPaymentId)&lt;br/&gt;FK (OriginalMethodAllocationId, OriginalPaymentId)&lt;br/&gt;OriginalPaymentId [enforcement key]&lt;br/&gt;Amount&lt;br/&gt;ReferenceNumber?&lt;br/&gt;CK Amount &amp;gt; 0" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
