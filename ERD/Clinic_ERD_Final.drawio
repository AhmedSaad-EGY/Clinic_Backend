        <mxCell id="audit" value="&lt;b&gt;Approvals &amp; Audit&lt;/b&gt;&lt;br/&gt;&lt;font color='#4b5563'&gt;Typed approvals and immutable audit events&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1f2937;spacing=10;fillColor=#e6e6e6;strokeColor=#666666;strokeWidth=2;arcSize=10;" vertex="1" parent="1">
