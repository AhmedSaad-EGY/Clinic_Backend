          <mxGeometry as="geometry" x="840" y="120" width="330" height="190"/>
        </mxCell>
        <mxCell id="user-session" value="&lt;b&gt;UserSession&lt;/b&gt;&lt;hr/&gt;PK Id (GUID)&lt;br/&gt;FK UserId&lt;br/&gt;AK RefreshTokenHash&lt;br/&gt;CreatedAt&lt;br/&gt;ExpiresAt&lt;br/&gt;RevokedAt?&lt;br/&gt;LastSeenAt?&lt;br/&gt;ClientFingerprint?&lt;br/&gt;CK CreatedAt &amp;lt; ExpiresAt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1230" y="120" width="340" height="255"/>
        </mxCell>
        <mxCell id="login-attempt" value="&lt;b&gt;LoginAttempt&lt;/b&gt;&lt;hr/&gt;PK Id&lt;br/&gt;FK UserId?&lt;br/&gt;UserNameAttempted&lt;br/&gt;WasSuccessful&lt;br/&gt;FailureReason?&lt;br/&gt;OccurredAt&lt;br/&gt;IpAddress?&lt;br/&gt;ClientInfo?" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1630" y="120" width="340" height="235"/>
        </mxCell>
        <mxCell id="auth-policy" value="&lt;b&gt;AuthenticationPolicy&lt;/b&gt;&lt;hr/&gt;PK Id (singleton, CK Id = 1)&lt;br/&gt;MaxFailedAttempts (default 5)&lt;br/&gt;LockoutMinutes&lt;br/&gt;SessionLifetimeMinutes&lt;br/&gt;UpdatedByAdminUserId&lt;br/&gt;UpdatedAt&lt;br/&gt;RowVersion" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
