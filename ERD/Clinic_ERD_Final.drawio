          <mxGeometry as="geometry" x="2630" y="520" width="290" height="120"/>
        </mxCell>
        <mxCell id="appointment" value="&lt;b&gt;Appointment&lt;/b&gt;&lt;hr/&gt;PK Id&lt;br/&gt;FK PatientId&lt;br/&gt;FK (RoomId, DepartmentId)&lt;br/&gt;DepartmentId [enforcement key]&lt;br/&gt;AK (Id, PatientId)&lt;br/&gt;AK (Id, DepartmentId)&lt;br/&gt;StartAt / EndAt&lt;br/&gt;Status (Booked/Suspended/Confirmed/Completed/Cancelled/NoShow)&lt;br/&gt;StatusBeforeSuspension? (Booked/Confirmed)&lt;br/&gt;PaymentStatus (Unpaid/Paid/PartiallyRefunded/Refunded)&lt;br/&gt;Subtotal / Discount / Net snapshots&lt;br/&gt;CreatedBy / UpdatedBy UserId&lt;br/&gt;CancelledAt? / CancelledBy?&lt;br/&gt;CancellationReason?&lt;br/&gt;RowVersion" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="900" width="360" height="390"/>
        </mxCell>
        <mxCell id="appointment-service" value="&lt;b&gt;AppointmentService&lt;/b&gt;&lt;hr/&gt;PK Id&lt;br/&gt;FK (AppointmentId, DepartmentId)&lt;br/&gt;FK (DoctorServiceId, ServiceId, DepartmentId)&lt;br/&gt;ServiceId / DepartmentId [enforcement keys]&lt;br/&gt;FK DiscountId?&lt;br/&gt;AK (Id, ServiceId, DepartmentId)&lt;br/&gt;AK (Id, ServiceId)&lt;br/&gt;AK (AppointmentId, SequenceNo)&lt;br/&gt;SequenceNo&lt;br/&gt;SegmentStartAt / SegmentEndAt&lt;br/&gt;Quantity&lt;br/&gt;UnitPrice / Gross snapshots&lt;br/&gt;Discount / Net snapshots&lt;br/&gt;DiscountOverrideMode? / Reason?&lt;br/&gt;DiscountOverrideByAdminUserId?&lt;br/&gt;Status (Scheduled/Completed/Cancelled/Superseded)&lt;br/&gt;RowVersion" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="900" width="430" height="445"/>
        </mxCell>
        <mxCell id="appointment-device" value="&lt;b&gt;AppointmentDevice&lt;/b&gt;&lt;hr/&gt;PK Id&lt;br/&gt;FK (AppointmentServiceId, ServiceId, DepartmentId)&lt;br/&gt;FK (ServiceDeviceId, ServiceId, DepartmentId, DeviceId)&lt;br/&gt;FK (DeviceId, DepartmentId)&lt;br/&gt;ServiceId / DepartmentId / DeviceId [enforcement keys]&lt;br/&gt;ReservedFrom / ReservedTo&lt;br/&gt;AK (AppointmentServiceId, ServiceDeviceId)&lt;br/&gt;CK ReservedFrom &amp;lt; ReservedTo" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=8;fontSize=12;fontColor=#1f2937;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1030" y="900" width="410" height="265"/>
        </mxCell>
        <mxCell id="cs-rules" value="&lt;b&gt;Scheduling invariants (must be transactional)&lt;/b&gt;&lt;hr/&gt;• Every AppointmentService belongs to the same department as the appointment room; composite FKs enforce this.&lt;br/&gt;• DoctorService proves that the selected doctor is eligible for that exact service.&lt;br/&gt;• AppointmentDevice proves that the device is configured for that exact service and department.&lt;br/&gt;• Prevent overlapping active intervals for the room, doctor, and each required device using a SERIALIZABLE transaction or application lock.&lt;br/&gt;• All segments must fall inside Appointment.StartAt–EndAt; appointment totals equal the sum of service snapshots.&lt;br/&gt;• A stopped department may create a Suspended booking with a warning; activation releases it only after conflict revalidation and restores Booked/Confirmed.&lt;br/&gt;• Superseded service lines preserve edit history but never reserve resources or affect current filters.&lt;br/&gt;• Confirmed/paid booking cancellation requires an approved request; ordinary unpaid bookings may be cancelled by a secretary.&lt;br/&gt;• Posting the payment and confirming a fully paid booking occurs in one database transaction.&lt;br/&gt;• CurrentPrice is admin-managed; historical bookings never recalculate after catalog or discount changes." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#1f2937;dashed=1;fillColor=#fffdf2;strokeColor=#d6b656;strokeWidth=1.3;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1540" y="870" width="1380" height="440"/>
        </mxCell>
        <mxCell id="cs-e01" value="1 — N | contains" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.25;labelBackgroundColor=#ffffff;startArrow=none;startFill=0;endArrow=classic;endFill=0;" edge="1" parent="1" source="department" target="room">
          <mxGeometry as="geometry" relative="1"/>
