          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pc-note" value="&lt;b&gt;Clinical-record rules&lt;/b&gt;&lt;hr/&gt;• The secretary transcribes what the doctor wrote; she does not author medical advice.&lt;br/&gt;• A finalized prescription cannot be edited by Secretary.&lt;br/&gt;• Admin correction creates a new revision and keeps the previous one.&lt;br/&gt;• A return date creates a follow-up record, not an appointment, until a time is selected.&lt;br/&gt;• Sensitive notes are visible to Admin only." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#1f2937;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="1060" width="900" height="190" as="geometry" />
        </mxCell>
      </root>
